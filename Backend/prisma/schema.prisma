// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------
// Enums
// ----------------------------
enum OtpPurpose {
  VERIFY_EMAIL
  LOGIN
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TwoFactorMethod {
  TOTP
  EMAIL
}

enum OrgType {
  INSTITUTION
  COMPANY
  NGO
  STUDIO
}

enum OrgStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OrgRole {
  OWNER
  ADMIN
  BILLING
  DEVICE_MANAGER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ----------------------------
// User (Auth + registration profile fields)
// ----------------------------
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String

  emailVerified Boolean  @default(false)

  // Individual registration fields (filled if user chose "Individual")
  firstName     String?
  lastName      String?
  dateOfBirth   DateTime? // required for individual onboarding (age gating)
  country       String?   // required for individual onboarding
  
  termsAccepted Boolean  @default(false)
  tosVersion    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Auth relations
  otps          EmailOtp[]
  sessions      Session[]
  twoFactor     TwoFactor?

  // Organization relations
  orgMemberships OrganizationMember[]

  // Developer relation
  developerProfile DeveloperProfile?

  @@index([createdAt])
}

// ----------------------------
// OTP (Email verification / login / reset)
// Store only hash of OTP, never plaintext.
// ----------------------------
model EmailOtp {
  id         String     @id @default(uuid())
  userId     String
  purpose    OtpPurpose

  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?

  // Anti-abuse / auditing
  attempts   Int        @default(0)
  lastTriedAt DateTime?
  ip         String?
  userAgent  String?

  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@index([usedAt])
}

// ----------------------------
// Sessions (recommended even if you also issue JWTs)
// Store refresh tokens hashed for rotation / logout-all-devices.
// ----------------------------
model Session {
  id               String        @id @default(uuid())
  userId           String
  status           SessionStatus @default(ACTIVE)

  refreshTokenHash String?       @unique
  refreshExpiresAt DateTime?

  ip               String?
  userAgent        String?
  deviceName       String?
  deviceId         String?

  createdAt        DateTime      @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([refreshExpiresAt])
  @@index([lastSeenAt])
}

// ----------------------------
// Two-Factor Auth (TOTP)
// totpSecretEnc must be encrypted (or store KMS ref).
// Recovery codes stored hashed.
// ----------------------------
model TwoFactor {
  id              String          @id @default(uuid())
  userId          String          @unique

  enabled         Boolean         @default(false)
  method          TwoFactorMethod @default(TOTP)

  totpSecretEnc   String?
  enabledAt       DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes   TwoFactorRecoveryCode[]

  @@index([enabled])
}

model TwoFactorRecoveryCode {
  id          String   @id @default(uuid())
  twoFactorId String

  codeHash    String   @unique
  usedAt      DateTime?

  createdAt   DateTime @default(now())

  twoFactor   TwoFactor @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  @@index([twoFactorId])
  @@index([usedAt])
}

// ===================================================
// Organization Registration (Institution scenario)
// ===================================================

model Organization {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  type      OrgType   @default(INSTITUTION)
  status    OrgStatus @default(UNVERIFIED)

  country   String?
  websiteUrl String?
  logoUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  verification OrganizationVerification?
  invites      OrganizationInvite[]

  @@index([status])
  @@index([type])
}

model OrganizationMember {
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@index([orgId])
}

model OrganizationInvite {
  id        String       @id @default(uuid())
  orgId     String

  // Invite is addressed to email (user may not exist yet)
  email     String
  tokenHash String
  role      OrgRole      @default(MEMBER)
  status    InviteStatus @default(PENDING)

  expiresAt DateTime
  createdAt DateTime     @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
  @@index([expiresAt])
}

model OrganizationVerification {
  id                 String   @id @default(uuid())
  orgId              String   @unique

  contactName        String?
  contactEmail       String?
  contactPhone       String?

  // Optional institutional details
  registrationNumber String?
  docsNote           String? // or move to separate table for file URLs later

  // Gatekeeping flags (your "Meta-like" checks)
  // You can enforce: org verification submission requires user-level 2FA enabled
  paymentMethodAdded Boolean  @default(false)

  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewNotes        String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([reviewedAt])
}

// ----------------------------
// Developer Profile (1:1 with User)
// Enables "developer capability" without separate account
// ----------------------------
model DeveloperProfile {
  id          String   @id @default(uuid())
  userId      String   @unique  // Ensures 1:1 and makes "enable" idempotent

  displayName String
  websiteUrl  String?
  bio         String?

  isVerified  Boolean  @default(false)  // Verified developer badge (future use)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isVerified])
  @@index([createdAt])
}

// ----------------------------
// Audit Log (for tracking sensitive actions)
// ----------------------------
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g., "DEVELOPER_ENABLED", "APP_PUBLISHED"
  metadata  Json?    // Additional context
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
